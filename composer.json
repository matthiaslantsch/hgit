{
	"name": "holonet/hgit",
	"description": "Project management application wrapping around git",
	"type": "project",
	"authors": [
		{
			"name": "matthias.lantsch",
			"email": "matthias.lantsch@bluewin.ch"
		}
	],
	"require": {
		"php": ">=8.4",
		"hackzilla/password-generator": "dev-master",
		"holonet/holofw": "~3.4.0",
		"holonet/sphinxauth": "~1.2.0",
		"parsedown/parsedown": "^1.7",
		"scrivo/highlight.php": "^9.18"
	},
	"require-dev": {
		"behat/behat": "^3.7",
		"behat/mink-goutte-driver": "^1.2",
		"behat/mink-zombie-driver": "^1.4",
		"friends-of-behat/mink-extension": "^2.2",
		"holonet/hdev": "~1.1.0"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://holonetz.synology.me/hgit/composer/"
		}
	],
	"minimum-stability": "dev",
	"autoload": {
		"psr-4": {
			"holonet\\hgit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"holonet\\hgit\\tests\\": "tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@php -d memory_limit=-1 vendor/holonet/holofw/bin/dewit cache refresh",
			"@php -d memory_limit=-1 vendor/holonet/holofw/bin/dewit db/migrate dry"
		],
		"post-update-cmd": [
			"@php -d memory_limit=-1 vendor/holonet/holofw/bin/dewit cache refresh"
		],
		"fix": [
			"@composer normalize --diff --ansi",
			"@php -d memory_limit=-1 vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --verbose --ansi --diff"
		],
		"test": [
			"@composer validate --ansi",
			"@composer normalize --dry-run --diff --ansi",
			"@php vendor/bin/hdev sync-dev-stubs --no-interactive",
			"@php -d memory_limit=-1 vendor/behat/behat/bin/behat --stop-on-failure --colors",
			"@php -d memory_limit=-1 vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --verbose --dry-run --ansi --diff",
			"@php -d memory_limit=-1 vendor/vimeo/psalm/psalm"
		]
	}
}
